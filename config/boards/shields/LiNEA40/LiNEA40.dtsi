#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "LiNEA40";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0     0     0>
            , <&key_physical_attrs 100 100  900    0       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100 1200    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0     0     0>
            , <&key_physical_attrs 100 100  900  100       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  100       0     0     0>
            , <&key_physical_attrs 100 100 1200  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  800  200       0     0     0>
            , <&key_physical_attrs 100 100  900  200       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  200       0     0     0>
            , <&key_physical_attrs 100 100 1200  200       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  300       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  300       0     0     0>
            , <&key_physical_attrs 100 100  500  300       0     0     0>
            , <&key_physical_attrs 100 100  700  300       0     0     0>
            , <&key_physical_attrs 100 100  800  300       0     0     0>
            , <&key_physical_attrs 100 100 1000  300       0     0     0>
            , <&key_physical_attrs 100 100 1100  300       0     0     0>
            , <&key_physical_attrs 100 100 1200  300       0     0     0>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>; 
        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0) RC(3,5) RC(3,7) RC(3,6)         RC(3,8) RC(3,9) RC(3,10)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //row0-D0
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //row1-D1
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //row2-D2
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //row3-D3
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <24>; // 3x finer events; behavior compensates distance
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
    behaviors {
        inertial_scroll: inertial_scroll {
            compatible = "zmk,behavior-inertial-scroll";
            #binding-cells = <1>;
            // v3.4: slower baseline to restore macOS slider headroom; stricter fast-only coast.
            frame-ms = <16>;
            tail-frames = <6>; // short glide after qualifying fast spin: <=6 frames
            rapid-threshold-ms = <18>; // only count very fast gaps
            grouping-threshold-ms = <45>; // prevents slow motion from initiating inertia
            rapid-impulse-q8 = <8>; // gentler post-stop glide velocity slope
            grouped-impulse-q8 = <90>; // lower post-stop glide starting velocity
            velocity-cap-q8 = <220>; // cap at ~0.86 HID fine units per 16ms frame
            decay-percent = <70>; // stronger deceleration after stop
            slow-detent-ticks = <2>; // Larger immediate wheel step when turning slowly
            rapid-detent-ticks = <1>; // Fallback for hosts without hi-res HID
            hires-detent-units = <2>; // 2 HID units per four 24-trigger events at 16x
            hires-immediate-units = <2>; // send each nonzero physical event immediately
            hires-chunk-units = <1>; // buffer only for any excess fine units
            encoder-trigger-divisor = <4>; // 25% less normal travel (16 -> 12 HID units/revolution at 16x)
            coast-wait-ms = <55>; // no synthetic acceleration during active rotation
            coast-min-fast-intervals = <7>; // eight quick events needed; rare coast
        };
    };

    // A pointing input source needs a listener for HID wheel reports.
    // Disabled on both halves by default; enabled only on central/right.
    inertia_input_listener: inertia_input_listener {
        compatible = "zmk,input-listener";
        device = <&inertial_scroll>;
        status = "disabled";
    };

};
